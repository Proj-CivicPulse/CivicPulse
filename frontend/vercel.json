{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": "vite",
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "rewrites": [
        {
            "source": "/api/core/:path*",
            "destination": "https://kind-caring-production-b166.up.railway.app/:path*"
        },
        {
            "source": "/api/ai/:path*",
            "destination": "https://civicpulse-production-6b16.up.railway.app/:path*"
        },
        { "source": "/(.*)", "destination": "/index.html" }
    ]
}
