{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": [
        "react",
        "typescript"
    ],
    "env": {
        "browser": true,
        "es2024": true
    },
    "ignorePatterns": [
        "dist",
        "node_modules",
        "*.config.ts"
    ],
    "rules": {
        "no-unused-vars": "warn",
        "no-console": "warn",
        "eqeqeq": "error"
    }
}