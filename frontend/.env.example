# Product name. Feeds src/config/constants.ts (APP_NAME) and the
# %VITE_APP_NAME% placeholders in index.html (title + social tags).
# vite.config.ts falls back to "CivicPulse" if this is unset.
VITE_APP_NAME=CivicPulse

# Used by vite.config.ts to configure the dev-server proxy.
# Frontend code itself calls relative paths (/api/core/..., /api/ai/...)
# and never reads these directly — see src/config/constants.ts.
VITE_SPRING_API_URL=http://localhost:8080
VITE_NODE_API_URL=http://localhost:3001

VITE_REQUEST_TIMEOUT_MS=10000

# CARTO basemap key — https://carto.com/ -> Developers -> API Keys.
# OPTIONAL. Leave blank and the map still works; CARTO just watermarks every
# tile with "API KEY REQUIRED".
#
# PUBLIC BY DESIGN: Vite inlines VITE_* vars into the shipped bundle, so treat
# this as visible to anyone. Restrict it by domain in the CARTO dashboard —
# that, not secrecy, is what protects the quota. Never give a server-side
# secret a VITE_ prefix.
VITE_CARTO_API_KEY=
