# Product name. Feeds src/config/constants.ts (APP_NAME) and the
# %VITE_APP_NAME% placeholders in index.html (title + social tags).
# vite.config.ts falls back to "CivicPulse" if this is unset.
VITE_APP_NAME=CivicPulse

# --- LOCAL DEV ONLY: where the Vite dev-server proxy forwards to -----------
# Read by vite.config.ts, never by application code. In dev the app calls the
# relative paths /api/core/* and /api/ai/*, and the proxy rewrites them to
# these targets. Irrelevant to a production build — Vercel serves static files
# and runs no proxy.
VITE_SPRING_API_URL=http://localhost:8080
VITE_NODE_API_URL=http://localhost:3001

# --- PRODUCTION: leave these UNSET -----------------------------------------
# The deployed app is served SAME-ORIGIN: vercel.json rewrites /api/core/* and
# /api/ai/* to the two Railway services, exactly mirroring the Vite dev proxy.
#
# WHY, and why this is not just a preference: the auth cookies from
# backend-spring are httpOnly + SameSite=Lax. A browser will not attach a Lax
# cookie to a CROSS-SITE request, so if the bundle called Railway directly
# (civicpulse.vercel.app -> *.up.railway.app), login would appear to succeed
# and then every authenticated request would 401. Keeping one origin also
# keeps csrf().disable() in SecurityConfig safe, since that is justified by
# the cookies being Lax.
#
# >>> ACTION REQUIRED: edit vercel.json and replace the two REPLACE-ME
# >>> hostnames with your real Railway URLs. vercel.json is static — Vercel
# >>> does NOT interpolate environment variables into rewrite destinations,
# >>> so those hostnames have to be literal.
#
# Setting the two variables below overrides the proxy and makes the bundle
# call the backends directly. Only do that if you have first moved the auth
# cookies to SameSite=None; Secure AND re-enabled CSRF protection.
# VITE_API_CORE_URL=
# VITE_API_AI_URL=

VITE_REQUEST_TIMEOUT_MS=10000

# CARTO basemap key — https://carto.com/ -> Developers -> API Keys.
# OPTIONAL. Leave blank and the map still works; CARTO just watermarks every
# tile with "API KEY REQUIRED".
#
# PUBLIC BY DESIGN: Vite inlines VITE_* vars into the shipped bundle, so treat
# this as visible to anyone. Restrict it by domain in the CARTO dashboard —
# that, not secrecy, is what protects the quota. Never give a server-side
# secret a VITE_ prefix.
VITE_CARTO_API_KEY=
