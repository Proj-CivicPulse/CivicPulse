# Optional overrides for docker-compose.yml (local Postgres + pgvector).
#
# Docker Compose auto-loads a file named ".env" in this directory. Copy
# this file to ".env" to change any value; ".env" is gitignored.
#
# These defaults are throwaway LOCAL-ONLY credentials and intentionally
# match backend-node/.env. Never reuse them for anything real.

POSTGRES_DB=civicpulse
POSTGRES_USER=civicpulse
POSTGRES_PASSWORD=civicpulse

# Host port mapped to the container's 5432. If you change it, also update
# DATABASE_URL in backend-node/.env to match.
POSTGRES_PORT=5432
