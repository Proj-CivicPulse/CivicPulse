# backend-node — environment configuration
#
# Copy to .env and fill in real values. .env is gitignored; .env.example
# is committed and must never contain real secrets.
#
# Every variable below is validated on startup by src/config/env.ts. The
# process exits with a clear message (no secret values printed) if any are
# missing or malformed.

# HTTP port. The frontend dev proxy forwards /api/ai/* here
# (see frontend/vite.config.ts).
PORT=3001

# development | production | test
NODE_ENV=development

# --- Database (Neon) ------------------------------------------------------
# Paste Neon's connection string as-is, EXCEPT:
#   - use the DIRECT host (the one WITHOUT `-pooler`) — this service runs its
#     own pg.Pool, so Neon's PgBouncer pooler would be a redundant second
#     pool. Switch to `-pooler` only for a serverless deployment.
#   - `sslmode=require` is mandatory; Neon refuses plaintext connections.
#   - `channel_binding` is safe to drop; node-postgres ignores it, and
#     sslmode already gives certificate verification.
#
# NOTE: this is a different format from backend-spring's DB_URL, which is a
# JDBC URL with credentials as separate properties. Do not copy one to the
# other.
#
# The schema — including the pgvector extension — is created by
# backend-spring's Flyway migrations. This service never runs DDL.
DATABASE_URL=postgres://neondb_owner:your-neon-password@ep-example-12345678.REGION.aws.neon.tech/neondb?sslmode=require

# Single allowed browser origin for CORS. No wildcards, ever.
FRONTEND_ORIGIN=http://localhost:5173

# Ceiling on the /health database probe, in ms. 10s absorbs a Neon cold
# start (the compute suspends when idle); drop it to ~3000 for a local
# database.
HEALTHCHECK_TIMEOUT_MS=10000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Phase 2: embeddings + incident matching -----------------------------

# backend-spring's base URL, for the /internal/* calls this service makes
# (complaint context in, match decision out). Not the browser-facing URL.
SPRING_INTERNAL_BASE_URL=http://localhost:8080

# Shared secret for BOTH directions of Spring<->Node internal traffic: sent as
# X-Internal-Token on calls to Spring, AND required on the inbound
# POST /complaints/:id/process. Must be identical to backend-spring's
# INTERNAL_TOKEN. Blank there denies /internal/*; blank here denies /process.
INTERNAL_TOKEN=

# Gemini embeddings. This is an AI Studio / Generative Language API key —
# a DIFFERENT key from backend-spring's GOOGLE_GEOCODING_API_KEY. Get one at
# https://aistudio.google.com/apikey
EMBEDDING_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
# Must equal the vector(<dim>) column in backend-spring's V6 migration.
# Changing it means re-embedding every complaint. 1536 is a Gemini "recommended"
# size and <= 2000, so a pgvector ANN index stays possible later.
EMBEDDING_DIMENSIONS=1536
# SEMANTIC_SIMILARITY | CLUSTERING | RETRIEVAL_DOCUMENT | RETRIEVAL_QUERY | CLASSIFICATION
EMBEDDING_TASK_TYPE=SEMANTIC_SIMILARITY
EMBEDDING_TIMEOUT_MS=10000

# Cosine-similarity cut-off for joining an existing incident vs. starting a new
# one. Empirical — tune in Phase 8; every score is logged regardless.
MATCH_SIMILARITY_THRESHOLD=0.75

# A PROCESSING claim older than this (seconds) is treated as abandoned and may
# be re-taken. MUST match backend-spring's app.matching.processing-stale-seconds.
# Node's compare-and-swap is the authority; the Spring value only pre-filters
# reconcile candidates, so drift just costs a wasted "skipped" round-trip.
PROCESSING_STALE_SECONDS=45

# --- Phase 6 (declared for visibility; not read yet) ---
# External LLM provider key — used by src/services/copilot.service.ts
# LLM_API_KEY=
