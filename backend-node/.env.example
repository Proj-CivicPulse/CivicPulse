# backend-node — environment configuration
#
# Copy to .env and fill in real values. .env is gitignored; .env.example
# is committed and must never contain real secrets.
#
# Every variable below is validated on startup by src/config/env.ts. The
# process exits with a clear message (no secret values printed) if any are
# missing or malformed.

# HTTP port. The frontend dev proxy forwards /api/ai/* here
# (see frontend/vite.config.ts).
PORT=3001

# development | production | test
NODE_ENV=development

# Postgres connection string. The database should have the pgvector
# extension available (CREATE EXTENSION IF NOT EXISTS vector) — this
# service will rely on it from Phase 2 onward.
DATABASE_URL=postgres://civicpulse:civicpulse@localhost:5432/civicpulse

# Single allowed browser origin for CORS. No wildcards, ever.
FRONTEND_ORIGIN=http://localhost:5173

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Phase 2+ (declared here for visibility; not read yet) ---
# External embedding provider key — used by src/services/embedding.service.ts
# EMBEDDING_API_KEY=
# External LLM provider key — used by src/services/copilot.service.ts
# LLM_API_KEY=
