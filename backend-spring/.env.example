# backend-spring — environment configuration
#
# Copy to .env and fill in real values:   cp .env.example .env
# .env is gitignored; .env.example is committed and must never contain a
# real secret. Loaded via `spring.config.import` in application.yaml.
#
# Every variable is resolved at startup; the app fails fast with a clear
# message if a required one is missing or invalid.

# --- Database (Neon) ------------------------------------------------------
# Neon gives you a libpq-style URL. JDBC needs a DIFFERENT shape:
#
#   Neon shows:  postgresql://USER:PASSWORD@HOST/DB?sslmode=require&channel_binding=require
#   JDBC wants:  jdbc:postgresql://HOST/DB?sslmode=require
#                + username and password as SEPARATE properties below
#
# Two differences that will bite you:
#   1. Credentials must NOT stay in the URL — put them in DB_USERNAME /
#      DB_PASSWORD. A password in a JDBC URL is not parsed the same way.
#   2. Drop `channel_binding` — it is a libpq parameter the JDBC driver does
#      not understand. `sslmode=require` is still mandatory; Neon refuses
#      plaintext connections.
#
# WHICH HOST: locally, use the DIRECT host (the one WITHOUT `-pooler`) — this
# service runs its own HikariCP pool, so the pooler adds nothing.
#
# In a DEPLOYED environment the `-pooler` host is fine for normal traffic, but
# you MUST then append `&prepareThreshold=0`. The PgJDBC driver promotes a
# statement to a server-side prepared statement after ~5 executions, and under
# PgBouncer's transaction pooling the next execution can land on a different
# server session — which fails with "prepared statement S_1 does not exist".
#
#   pooled:  jdbc:postgresql://ep-example-12345678-pooler.REGION.aws.neon.tech/neondb?sslmode=require&prepareThreshold=0
#
DB_URL=jdbc:postgresql://ep-example-12345678.REGION.aws.neon.tech/neondb?sslmode=require
DB_USERNAME=neondb_owner
DB_PASSWORD=your-neon-password

# OPTIONAL, and ONLY needed if DB_URL above points at the `-pooler` host.
#
# Flyway holds a SESSION-level advisory lock for the whole migration run, and
# PgBouncer in transaction-pooling mode does not keep one client pinned to one
# server session — so that lock cannot be relied on through the pooler. Point
# this at the DIRECT host (no `-pooler`, no `prepareThreshold`) and migrations
# run over a real session while normal traffic still uses the pool.
#
# Unset, it falls back to DB_URL / DB_USERNAME / DB_PASSWORD, which is the
# right thing locally and anywhere not going through a pooler.
# DB_MIGRATION_URL=jdbc:postgresql://ep-example-12345678.REGION.aws.neon.tech/neondb?sslmode=require
# DB_MIGRATION_USERNAME=neondb_owner
# DB_MIGRATION_PASSWORD=your-neon-password

# OPTIONAL: aim the test suite at a different database from the app.
# `./mvnw verify` is a real integration test — it runs the migrations and
# validates every JPA entity against the result — so by default it hits
# whatever DB_URL above points at. Uncomment these to send it at a throwaway
# Neon branch instead (recommended for CI and for a shared team database).
# See src/test/resources/application-test.yaml.
# TEST_DB_URL=
# TEST_DB_USERNAME=
# TEST_DB_PASSWORD=

# --- HTTP -----------------------------------------------------------------
# Local port. application.yaml binds ${PORT:${SERVER_PORT:8080}}, so PORT wins
# wherever it is set and SERVER_PORT is the local fallback.
SERVER_PORT=8080

# The port the platform routes to. Leave it UNSET locally — SERVER_PORT above
# covers that. On a PaaS it is normally injected for you, so only set it
# explicitly when you also pin the target port on the service's public domain
# (Railway asks for one when you generate or attach a domain). The two must
# agree, or the domain routes to a port nothing is listening on.
# PORT=8080

# Allowed browser origins for CORS, COMMA-SEPARATED. Credentials are enabled,
# so a bare "*" is rejected at startup — but an individual entry MAY contain a
# "*" wildcard, which is how Vercel's per-commit preview URLs are covered:
#
#   FRONTEND_ORIGIN=https://civicpulse.vercel.app,https://civicpulse-*.vercel.app
#
# Keep the same value in backend-node's FRONTEND_ORIGIN; both services match it
# identically.
FRONTEND_ORIGIN=http://localhost:5173

# Mark auth cookies Secure. Keep false for local http://; MUST be true in
# any environment served over HTTPS (i.e. true on Railway).
COOKIE_SECURE=false

# Ceiling on the /health database probe. 10s absorbs a Neon cold start
# (the compute suspends when idle); drop it to ~3 for a local database.
HEALTH_TIMEOUT_SECONDS=10

# --- Auth -----------------------------------------------------------------
# HMAC-SHA signing key. MUST be at least 32 characters — the app refuses to
# start otherwise (a short key silently weakens every token).
# Generate one:  openssl rand -base64 48
JWT_SECRET=replace-me-with-at-least-32-random-characters

# Token lifetimes in milliseconds. The access lifetime is also the ceiling on
# how long a role changed directly in SQL takes to reach a signed-in user.
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# Login brute-force budgets. Two independent counters:
#   per email — stops one account being guessed at. Keep it tight; a real
#               person does not fail five times and then succeed.
#   per IP    — catches spraying (one common password across many accounts),
#               which never trips a per-account limit. Keep it loose: an
#               office or carrier NAT puts many innocent users on one address.
AUTH_MAX_ATTEMPTS_PER_EMAIL=5
AUTH_MAX_ATTEMPTS_PER_IP=50
# Failures older than this stop counting; a locked key stays locked this long.
AUTH_ATTEMPT_WINDOW_SECONDS=900
AUTH_LOCKOUT_SECONDS=900
# Ceiling on tracked login keys — email keys are attacker-chosen strings, so
# the table needs a bound or a flood of invented addresses exhausts memory.
AUTH_MAX_TRACKED_KEYS=100000
# How long an already-rotated refresh token is still accepted as a genuine
# two-tab race rather than a replayed theft. Without it, ordinary multi-tab
# use would occasionally sign people out of everything.
AUTH_REFRESH_REUSE_GRACE_SECONDS=30

# Budgets for the endpoints that SEND mail (verification resend, password
# reset). Every request counts, not just failures — the send IS the abuse:
# these endpoints mail an address the caller names, so unthrottled they are an
# email-bombing tool aimed at someone else's inbox and a fast way to get the
# sending domain blacklisted.
AUTH_EMAIL_REQUESTS_PER_ADDRESS=3
AUTH_EMAIL_REQUESTS_PER_IP=10
AUTH_EMAIL_REQUEST_WINDOW_SECONDS=3600

# --- Email (verification + password reset) ---------------------------------
# "log" (default) prints the message — link included — to the console instead
# of sending it, so BOTH flows work end to end on a fresh clone with no Resend
# account and no key. "resend" turns on real delivery.
#
# Never set this to "log" in production: it would put live password-reset
# links, which are account takeover, into your log aggregator.
EMAIL_PROVIDER=log

# Resend API key (https://resend.com → API Keys). Server-side only; it never
# reaches the browser, so it can be restricted and rotated freely.
RESEND_API_KEY=

# Must be on a domain verified with Resend, OR their shared test sender
# `onboarding@resend.dev`, which needs no domain setup but can only deliver to
# the address that owns the Resend account. Verify a real domain before a demo.
EMAIL_FROM_ADDRESS=CivicPulse <onboarding@resend.dev>

# Where emailed links point. This is the FRONTEND, not this service — a human
# clicks them and has to land on a page. Must match how the app is actually
# reached, or every link in every email 404s.
EMAIL_LINK_BASE_URL=http://localhost:5173

# Link lifetimes. Verification is long (expiry only costs a confused user
# another request); reset is short, because that token IS the account until
# it is used.
EMAIL_VERIFICATION_TTL_HOURS=24
EMAIL_RESET_TTL_MINUTES=60

# Trust X-Forwarded-For for the client address, which the per-IP budget keys on.
# "none" (default) is SAFE: with no proxy in front, trusting it would let any
# caller spoof a new IP per request and walk around the limit entirely.
# Set to "framework" ONLY behind a reverse proxy you control that overwrites
# the header. Leaving it "none" there is not a hole — it just collapses every
# user into the proxy's one address, throttling everyone together.
# Railway terminates TLS and sets X-Forwarded-* itself, so "framework" is the
# correct value there.
FORWARD_HEADERS_STRATEGY=none

# --- Logging --------------------------------------------------------------
# TRACE | DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO

# --- Ward resolution -------------------------------------------------------
# "centroid" (nearest seeded ward centroid) or a future "postgis".
WARD_RESOLVER=centroid
# Points further than this from every ward centroid resolve to no ward (404).
WARD_RESOLUTION_MAX_KM=25

# --- Service-to-service auth ----------------------------------------------
# Shared secret for BOTH directions of Spring<->Node internal traffic:
#   - backend-node sends it as X-Internal-Token on /internal/* calls to Spring
#   - Spring sends it on POST {node}/complaints/{id}/process, and Node requires it
# Must be identical to backend-node's INTERNAL_TOKEN. BLANK DENIES EVERYTHING -
# /internal/* fails closed when this is unset. Generate one: openssl rand -hex 32
INTERNAL_TOKEN=

# --- Phase 2 semantic matching (Spring -> Node trigger) -------------------
# backend-node's base URL. The async trigger POSTs /complaints/{id}/process here.
NODE_BASE_URL=http://localhost:3001
# Read timeout on the trigger call (ms). Short on purpose: the citizen already
# has their response, and a slow Node keeps the PROCESSING claim and finishes.
MATCHING_PROCESS_TIMEOUT_MS=2500
# A PROCESSING claim older than this (seconds) is stale and the reconcile sweep
# offers it again. MUST match backend-node's PROCESSING_STALE_SECONDS — Node's
# compare-and-swap is the authority; this only pre-filters reconcile candidates.
MATCHING_PROCESSING_STALE_SECONDS=45
# Circuit breaker: consecutive connection failures before Node calls are
# suspended, and for how long.
MATCHING_CB_FAILURES=3
MATCHING_CB_OPEN_SECONDS=60
# Reconcile sweep: re-runs the real pipeline over pending/degraded/stale
# complaints once Node is healthy again.
MATCHING_RECONCILE_ENABLED=true
MATCHING_RECONCILE_INTERVAL_MS=60000
MATCHING_RECONCILE_BATCH=25

# --- Reverse geocoding -----------------------------------------------------
# "none" (default) leaves addresses null and needs no key or billing account.
# "google" turns on street-address lookup for complaint and incident locations.
GEOCODING_PROVIDER=none
# SERVER-SIDE ONLY. Never reaches the browser, so unlike a Maps JS key this one
# stays secret — restrict it by IP address, not HTTP referrer.
GOOGLE_GEOCODING_API_KEY=
# Decimal places the reverse-geocode cache key rounds to. 3 is ~111 m.
# Measured against real report data, 4 (~11 m) only achieved a 3% cache hit
# rate — two people reporting one pothole do not drop pins within 11 m of each
# other. Lower it to 4 for a sparser city where 111 m spans several addresses.
GEOCODING_CACHE_KEY_SCALE=3

# Bounds on outbound third-party calls. An untimed client pins a request thread
# when the provider is slow, which is how one dependency takes down the service.
HTTP_CONNECT_TIMEOUT_MS=3000
HTTP_READ_TIMEOUT_MS=5000

# --- Incident grouping (the NAIVE FALLBACK matcher) -----------------------
# Since Phase 2 this is the fallback that runs only when backend-node is
# unreachable; it tags the complaint "degraded" and the reconcile sweep
# upgrades it later. "none" disables the fallback (complaints stay "pending"
# until reconciliation). "naive" = ward + category + window + radius.
INCIDENT_GROUPING_STRATEGY=naive
INCIDENT_GROUPING_WINDOW_DAYS=14
INCIDENT_GROUPING_MAX_KM=1.5
